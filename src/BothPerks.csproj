<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>BothPerks.Core</AssemblyName>
    <RootNamespace>BothPerks</RootNamespace>
    <BannerlordTarget Condition="'$(BannerlordTarget)'==''">v1_3</BannerlordTarget>
    <DefineConstants Condition="'$(BannerlordTarget)'=='v1_2'">$(DefineConstants);BANNERLORD_V12</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)..\bin\Win64_Shipping_Client\compat\$(BannerlordTarget)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Optimize>true</Optimize>
    <BannerlordRoot Condition="'$(BannerlordRoot)'=='' and '$(BANNERLORD_ROOT)'!=''">$(BANNERLORD_ROOT)</BannerlordRoot>
    <BannerlordRoot Condition="'$(BannerlordRoot)'==''">D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordRoot>
    <GameDir Condition="'$(GameDir)'==''">$(BannerlordRoot)\bin\Win64_Shipping_Client</GameDir>
    <WorkshopDir Condition="'$(WorkshopDir)'==''">D:\SteamLibrary\steamapps\workshop\content\261550</WorkshopDir>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Bootstrap\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(GameDir)\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem.ViewModelCollection">
      <HintPath>$(GameDir)\TaleWorlds.CampaignSystem.ViewModelCollection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(GameDir)\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(GameDir)\TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(GameDir)\TaleWorlds.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(GameDir)\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(GameDir)\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony" Condition="Exists('$(GameDir)\..\..\Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll')">
      <HintPath>$(GameDir)\..\..\Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony" Condition="Exists('$(GameDir)\..\..\Modules\TEMPDIsabled\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll')">
      <HintPath>$(GameDir)\..\..\Modules\TEMPDIsabled\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony" Condition="Exists('$(GameDir)\..\..\Modules\TEMPDIsabled\\Harmony-2006-v2-4-2-225-1764271270\\Modules\\Bannerlord.Harmony\\bin\\Win64_Shipping_Client\\0Harmony.dll')">
      <HintPath>$(GameDir)\..\..\Modules\TEMPDIsabled\\Harmony-2006-v2-4-2-225-1764271270\\Modules\\Bannerlord.Harmony\\bin\\Win64_Shipping_Client\\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony" Condition="Exists('$(WorkshopDir)\2859188632\bin\Win64_Shipping_Client\0Harmony.dll')">
      <HintPath>$(WorkshopDir)\2859188632\bin\Win64_Shipping_Client\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MCMv5" Condition="Exists('$(GameDir)\..\..\Modules\Mod Configuration Menu-612-v5-9-1-1689655614\Modules\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll')">
      <HintPath>$(GameDir)\..\..\Modules\Mod Configuration Menu-612-v5-9-1-1689655614\Modules\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MCMv5" Condition="Exists('$(GameDir)\..\..\Modules\TEMPDIsabled\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll')">
      <HintPath>$(GameDir)\..\..\Modules\TEMPDIsabled\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MCMv5" Condition="Exists('$(GameDir)\..\..\Modules\TEMPDIsabled\Mod Configuration Menu-612-v5-9-1-1689655614\Modules\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll')">
      <HintPath>$(GameDir)\..\..\Modules\TEMPDIsabled\Mod Configuration Menu-612-v5-9-1-1689655614\Modules\Bannerlord.MBOptionScreen\bin\Win64_Shipping_Client\MCMv5.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MCMv5" Condition="Exists('$(WorkshopDir)\2859238197\bin\Win64_Shipping_Client\MCMv5.dll')">
      <HintPath>$(WorkshopDir)\2859238197\bin\Win64_Shipping_Client\MCMv5.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="EnsureGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDir)'==''" Text="Set GameDir (or environment variable BANNERLORD_DIR) to your Bannerlord bin\Win64_Shipping_Client path." />
    <Error Condition="!Exists('$(GameDir)')" Text="GameDir '$(GameDir)' does not exist. Set it to your Bannerlord bin\Win64_Shipping_Client path." />
  </Target>
  <Target Name="ValidateBannerlordTarget" BeforeTargets="BeforeBuild">
    <Error Condition="'$(BannerlordTarget)'!='v1_2' and '$(BannerlordTarget)'!='v1_3' and '$(BannerlordTarget)'!='v1_4'"
           Text="BannerlordTarget must be v1_2, v1_3, or v1_4." />
  </Target>
</Project>
